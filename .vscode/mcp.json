{
  "servers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--isolated",
        "--no-usage-statistics",
        "--viewport=1280x720"
      ],
      "type": "stdio"
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://webcrawler:webcrawler@123@localhost:5432/webcrawler"
      ],
      "type": "stdio"
    },
    "redis": {
      "command": "npx",
      "args": ["-y", "redis-mcp@latest"],
      "env": {
        "REDIS_URL": "redis://webcrawler:webcrawler@123@localhost:6379"
      },
      "type": "stdio"
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "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"
      },
      "type": "stdio"
    }
  }
}
