# ============================================================
# Allow-list model: exclude EVERYTHING, then explicitly permit
# only what the build actually needs. Any new junk added to the
# repo stays out of the image by default.
# ============================================================

# 1) Ignore everything at the root of the build context
**

# 2) Whitelist the source + configs that `npm run build` (tsc +
#    tailwind) actually reads.
!package.json
!package-lock.json
!tsconfig.json
!tailwind.config.js
!src/**
!public/**

# 3) Even inside whitelisted dirs, prune stuff that must not
#    enter the image.
public/index.html.bak
public/**/*.map
src/**/*.test.ts
src/**/*.spec.ts

# 4) Never allow secrets, git, editor state, or agent skills to
#    leak into a layer even if a whitelist somehow catches them.
.env
.env.*
.git
.gitignore
.github
.vscode
.agents
node_modules
dist
tmp
coverage
test-results
playwright-report
deploy
scripts
docs
tests
*.log
*.bak
skills-lock.json
