# ── Build output ─────────────────────────────────────────────
node_modules/
dist/
tmp/
coverage/

# ── Secrets (never commit — repo is PUBLIC) ──────────────────
# Environment values live in the developer's own shell / GitHub Actions
# secrets / the VPS filesystem, never in the tree.
.env
.env.*
!.env.example

# Cloudflare Origin certs, SSH keys, cloud API tokens — anything private.
deploy/secrets/
deploy/certs/*.crt
deploy/certs/*.key
*.pem
*.key
!public/mask-icon.svg

# ── Editor / agent workspace state ───────────────────────────
.vscode/
.idea/
skills-lock.json
.agents/skills-lock.json

# ── OS junk ──────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Backups ──────────────────────────────────────────────────
*.bak
*.swp

# ── Logs ─────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
