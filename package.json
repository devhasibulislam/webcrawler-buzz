{
  "name": "webcrawler.buzz",
  "version": "2.3.8",
  "description": "🕷️ A domain crawler that discovers every page of any website — built with Express.js, TypeScript, BullMQ, and Neon PostgreSQL.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "npm run css:build && tsc",
    "css:build": "tailwindcss -i src/styles/input.css -o public/styles.css --minify",
    "css:watch": "tailwindcss -i src/styles/input.css -o public/styles.css --watch",
    "start": "node dist/index.js",
    "migrate": "ts-node src/db/migrate.ts",
    "lint": "eslint --config eslint.config.cjs src/**/*.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "fresh": "clear && npm install -f && npm run lint && npm run build && npm run dev"
  },
  "keywords": [
    "nodejs",
    "redis",
    "crawler",
    "typescript",
    "neon",
    "web-crawler",
    "postgresql",
    "expressjs",
    "seo-tools",
    "bullmq"
  ],
  "author": "Hasibul Islam <devhasibulislam@gmail.com>",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.20.0",
    "baseline-browser-mapping": "^2.11.21",
    "bullmq": "^5.70.4",
    "caniuse-lite": "^1.0.30001810",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "marked": "^18.0.11",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "pg": "^8.20.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.9.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
