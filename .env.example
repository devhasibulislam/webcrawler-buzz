# Example environment file.
# Copy this to `.env` for local dev; never commit real values.
# Production values live in GitHub Actions secrets + the VPS filesystem.

PORT=5005
NODE_ENV=development
APP_BASE_URL=http://localhost:5005

# Postgres (Neon in prod; any 16+ locally).
DATABASE_URL=postgres://user:password@localhost:5432/webcrawler

# Redis (BullMQ queues + rate limiting).
REDIS_URL=redis://localhost:6379

# Outbound email for crawl-complete notifications and CSV export delivery.
# In dev you can leave these blank — email calls silently no-op.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Basic auth for /api-docs (Swagger UI).
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=change-me

# CORS allow-list, comma-separated.
ALLOWED_ORIGIN=http://localhost:5005
